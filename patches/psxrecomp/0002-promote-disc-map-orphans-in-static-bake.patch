+def _promotion_culprits(result) -> set:
+    """Promoted roots that own a word the failed audit flagged unsupported.
+
+    Walks stop at the next root, so the owner of a word is the nearest root at
+    or below it. An unknown_bad target names a callee, not its caller, so that
+    failure blames nobody."""
+    reasons = result.get('included_reasons') or {}
+    if result.get('audit_unknown_bad'):
+        return set()
+    roots = sorted(a for a, r in reasons.items() if r != 'DISPATCH_INTERIOR')
+    blamed = set()
+    for addr in result.get('audit_unsupported') or ():
+        i = bisect_left(roots, addr + 1) - 1
+        if i >= 0 and reasons[roots[i]] == 'DISPATCH_ROOT':
+            blamed.add(roots[i])
+    return blamed
